{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "assistant",

  // ─── HARVEST PLUGINS ─────────────────────────
  "plugin": [
    "file:///root/.opencode/plugins/fast-tools.ts",
    "file:///root/.opencode/plugins/doom-loop.ts",
    "file:///root/.opencode/plugins/smart-truncation.ts",
    "file:///root/.opencode/plugins/pending-todos.ts",
    "file:///root/.opencode/plugins/compaction-enhancer.ts"
  ],

  // ─── COMPACTION ──────────────────────────────
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 2,
    "preserve_recent_tokens": 4000
  },

  // ─── TOOL OUTPUT ─────────────────────────────
  "tool_output": {
    "max_lines": 200,
    "max_bytes": 51200
  },

  "agent": {
    "assistant": {
        "mode": "primary",
        "model": "opencode/deepseek-v4-flash-free",
        "prompt": "{file:agents/main/assistant.md}",
        "steps": 30,
        "permission": {
          "bash": { "*": "allow", "curl *": "allow", "opencode *": "allow", "ls *": "allow", "rm -rf *": "ask", "rm *": "ask"},
          "edit": "ask"
      }
    },
    "doctor": {
      "mode": "subagent",
      "model": "openrouter/poolside/laguna-xs.2:free",
      "prompt": "{file:agents/config/doctor.md}",
      "permission": {
        "task": "deny",
        "bash": {"*": "deny"},
        "read": {"*": "allow"},
        "glob": {"*": "allow"},
        "grep": {"*": "allow"},
        "edit": "ask"
      }
    },
    "code-review": {
        "mode": "subagent",
        "model": "openai/gpt-5.5",
        "prompt": "{file:agents/dev/code-review.md}",
        "permission": {
          "bash": {"*": "deny", "curl *": "allow"}
      }
    },
    "coder": {
        "mode": "subagent",
        "model": "opencode/deepseek-v4-flash-free",
        "prompt": "{file:agents/dev/coder.md}",
        "permission": {
          "bash": {"*": "ask"},
          "read": "allow",
          "edit": "allow"
      }
    },
    "explore": {
      "mode": "subagent",
      "model": "opencode/deepseek-v4-flash-free",
      "prompt": "{file:agents/helper/explore.md}",
      "permission": {
        "task": "deny",
        "bash": {"*": "ask","cat": "allow","ls": "allow"},
        "edit": "ask"
      }
    },
    "task-organizer": {
        "mode": "subagent",
        "model": "openai/gpt-5.4-fast",
        "prompt": "{file:agents/helper/task-organizer.md}",
        "permission": {
            "bash": {"*": "deny", "ls": "allow", "cat": "allow"},
            "task": "deny",
            "edit": "deny"
        }
    },
    "research": {
      "mode": "subagent",
      "model": "openrouter/nvidia/nemotron-3-super-120b-a12b:free",
      "permission": {
          "read": "ask",
          "edit": "ask",
          "bash": {
            "*": "deny", "ls": "allow", "cat": "allow"
          }
      }
    }
  }
}
