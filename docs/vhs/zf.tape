# ==============================================================================
# VHS Tape: ZF Zoxide Rapid Engine Showcase
# Render GIF: vhs docs/vhs/zf.tape
# Output: docs/assets/gif/zf-demo.gif
# ==============================================================================
Output docs/assets/gif/zf-demo.gif

Set Shell "zsh"
Set FontSize 15
Set Width 1200
Set Height 750
Set Theme "Catppuccin Mocha"
Set WindowBar Colorful
Set Margin 20

Type "zf"
Enter
Sleep 2s

Down 2
Sleep 800ms
Down 1
Sleep 800ms

Escape
Sleep 1s
