{
  "$schema": "https://opencode.ai/tui.json",
  "diff_style": "auto",
  "keybinds": {
    "sidebar_toggle": {
      "key": { "name": "s", "ctrl": true }
    },
    "app_exit": {
      "key": { "name": "c", "ctrl": true }
    }
  },
  "mouse": true,
  "attention": {
    "enabled": true,
    "notifications": true,
    "sound": true,
    "volume": 1
  }
}