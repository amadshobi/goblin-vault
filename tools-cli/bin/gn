#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────
# Wrapper executable untuk Goblin Nexus CLI (gn)
# Thin launcher — setup env lalu exec ke router TypeScript.
# ─────────────────────────────────────────────────────────────
set -euo pipefail

# Resolve physical path in case of symlinks in ~/.local/bin/
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
BIN_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
export GOBLIN_VAULT_ROOT="$(cd -P "$BIN_DIR/../.." >/dev/null 2>&1 && pwd)"
TARGET_FILE="$GOBLIN_VAULT_ROOT/tools-cli/src/gn/src/index.ts"

if command -v bun &>/dev/null; then
  exec bun "$TARGET_FILE" "$@"
elif command -v node &>/dev/null; then
  exec node --import tsx/esm "$TARGET_FILE" "$@" 2>/dev/null || exec npx tsx "$TARGET_FILE" "$@"
elif command -v deno &>/dev/null; then
  exec deno run -A "$TARGET_FILE" "$@"
else
  echo "❌ Error: Runtime JavaScript/TypeScript (bun, node/tsx, atau deno) tidak ditemukan!" >&2
  echo "💡 Goblin Roast Hint: Install Bun via 'curl -fsSL https://bun.sh/install | bash' atau 'sup'!" >&2
  exit 1
fi
