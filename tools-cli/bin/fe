#!/usr/bin/env bash
# ============================================================
# fe — File Explorer with fzf + tmux split (v3.0 - Modular)
# Letak: tools-cli/bin/fe
# ============================================================
set -euo pipefail

# ── Cleanup System ──
CLEANUP_FILES=()
cleanup() {
  for file in "${CLEANUP_FILES[@]}"; do
    rm -f "$file"
  done
}
trap cleanup EXIT

# ── Load Core Modules ──
FE_LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../src/fe" && pwd)"
export FE_LIB_DIR
source "$FE_LIB_DIR/config.sh"
source "$FE_LIB_DIR/tmux.sh"
source "$FE_LIB_DIR/ui.sh"
source "$FE_LIB_DIR/find.sh"
source "$FE_LIB_DIR/tree.sh"
source "$FE_LIB_DIR/search.sh"
source "$FE_LIB_DIR/bookmarks.sh"

# ── FZF Helper Wrapper ──
# fzf execute() runs in a new shell; this wrapper sources the lib
# so helper functions (fe_rename_selected, fe_delete_selected) are available.
FE_FZF_HELPER="$(mktemp /tmp/fe-fzf-helper-XXXXXX.sh)"
cat > "$FE_FZF_HELPER" << HELPEREOF
#!/usr/bin/env bash
source "${FE_LIB_DIR}/ui.sh" 2>/dev/null || exit 1
"\$@"
HELPEREOF
chmod +x "$FE_FZF_HELPER"
CLEANUP_FILES+=("$FE_FZF_HELPER")
export FE_FZF_HELPER

# ── Show Help ──
show_help() {
  cat <<EOF
fe — File Explorer with fzf + tmux split (v3.0 - Modular)

Usage:
  fe                     Browse files from current directory
  fe <path>              Browse files from <path>
  fe <extension>         Filter by extension (e.g. fe .js)
  fe <path> <extension>  Both
  fe --search <query>    Search file content
  fe --tree              Tree navigation (folder explorer)
  fe --bookmarks         Browse bookmarked files
  fe -h, --help          Show help

Keybindings (inside fzf):
  Enter       Open file (switch focus / split if busy in tmux)
  Tab         Multi-select
  Ctrl-d      Delete file (with confirmation & auto-reload)
  Ctrl-r      Rename file (with confirmation & auto-reload)
  Ctrl-g      Git status / log
  Ctrl-f      Search content (rg) — type query after trigger
  Ctrl-y      Copy file path to clipboard
  Ctrl-b      Bookmark current file
  Ctrl-x      Remove bookmark for current file
  Ctrl-o      Open file location in shell (right pane)
  Ctrl-p      Toggle preview

Tree mode keybindings:
  Enter       Open folder (navigate in) / Open file
  Esc / Ctrl-h  Go up one directory
  Ctrl-n      Create new file + open editor
  Ctrl-k      Create new folder
  Ctrl-p      Toggle preview
EOF
  exit 0
}

# ── Parse Args ──
SEARCH_MODE=false
SEARCH_QUERY=""
TREE_MODE=false
BOOKMARK_MODE=false
TARGET_DIR="."
EXT_FILTER=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) show_help ;;
    --search|-s)
      SEARCH_MODE=true
      SEARCH_QUERY="${2:-}"
      shift 2 || shift
      ;;
    --tree|-t)
      TREE_MODE=true
      shift
      ;;
    --bookmarks|-b)
      BOOKMARK_MODE=true
      shift
      ;;
    *)
      if [[ -d "$1" ]]; then
        TARGET_DIR="$1"
      else
        EXT_FILTER="$1"
      fi
      shift
      ;;
  esac
done

# ── Resolve target directory ──
if [[ "$TARGET_DIR" =~ ^~ ]]; then
  TARGET_DIR="$HOME${TARGET_DIR:1}"
fi
TARGET_DIR="$(cd "$TARGET_DIR" 2>/dev/null && pwd)" || {
  echo "Error: Cannot access $TARGET_DIR"
  exit 1
}

# ── Setup tmux split if active ──
setup_tmux_split

# ── Dispatcher (Mode Selector) ──
if [[ "$TREE_MODE" == true ]]; then
  run_tree_mode
elif [[ "$BOOKMARK_MODE" == true ]]; then
  run_bookmarks_mode
elif [[ "$SEARCH_MODE" == true ]]; then
  run_search_mode
else
  run_find_mode
fi
