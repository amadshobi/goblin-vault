#!/usr/bin/env bash
# fex — File Explorer with fzf (Go hybrid)
# Letak: tools-cli/bin/fex
set -euo pipefail

FEX_SRC="$(cd "$(dirname "${BASH_SOURCE[0]}")/../src/fex" && pwd)"

# Coba pake binary yang udah terinstall dulu
if command -v fex &>/dev/null; then
  exec fex "$@"
fi

# Fallback: build & run dari source
echo "🔨 fex binary not found in PATH — building from source..." >&2
cd "$FEX_SRC" && go build -o fex ./cmd/fe/ && exec ./fex "$@"
