# ─────────────────────────────────────────────────────────────
# Goblin Shield — Auto Telemetry & Privacy Interceptor Daemon
# Systemd User Service
# ─────────────────────────────────────────────────────────────
# Install:
#   systemctl --user daemon-reload
#   systemctl --user enable --now gn-shield.service
#
# Verify:
#   systemctl --user status gn-shield.service
#   journalctl --user -u gn-shield.service -f
# ─────────────────────────────────────────────────────────────

[Unit]
Description=🛡️ Goblin Shield — Privacy Interceptor & Auto Telemetry Logger
Documentation=https://github.com/shobix/goblin-vault
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple

# ── Paths ──
Environment=GOBLIN_VAULT_ROOT=%h/civil/goblin-vault
Environment=SHIELD_LISTEN_PORT=4002
Environment=SHIELD_TARGET_PORT=4000
Environment=SHIELD_TARGET_HOST=127.0.0.1

# ── Runtime ──
ExecStart=/home/shobixlinuxdev/.npm-global/bin/bun run /home/shobixlinuxdev/civil/goblin-vault/tools-cli/src/shield/shield-interceptor.ts
WorkingDirectory=%h/civil/goblin-vault

# ── Resilience ──
Restart=always
RestartSec=2

# ── Security & Sandboxing ──
ProtectSystem=strict
PrivateTmp=true
NoNewPrivileges=true

# Allow write access to telemetry DB, shield log, and pricing config
ReadWritePaths=%h/.cache/goblin-nexus
ReadWritePaths=%h/.config/goblin-nexus
ReadWritePaths=%h/civil/goblin-vault/tools-cli/src/shield

# Allow network access (needed for proxy)
PrivateNetwork=no

# ── Logging ──
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
