# ─────────────────────────────────────────────────────────────
# Goblin Nexus Gateway — Interceptor, Caching & Fallback Daemon
# Systemd User Service
# ─────────────────────────────────────────────────────────────
# Install:
#   systemctl --user daemon-reload
#   systemctl --user enable --now gn-gateway.service
#
# Verify:
#   systemctl --user status gn-gateway.service
#   journalctl --user -u gn-gateway.service -f
# ─────────────────────────────────────────────────────────────

[Unit]
Description=👹 Goblin Nexus Gateway — LLM Interceptor, Deterministic Cache & Fallback Daemon
Documentation=https://github.com/shobix/goblin-vault
After=network.target network-online.target omp.service
Wants=network-online.target

[Service]
Type=simple

# ── Environment ──
# Listen 4010 (tidak mengganggu OMP ecosystem di 4000-4002):
#   opencode -> gn-gateway:4010 -> gateway-proxy:4000 -> omp auth-gateway:4002
Environment=GOBLIN_VAULT_ROOT=%h/civil/goblin-vault
Environment=GN_GATEWAY_PORT=4010
Environment=GN_GATEWAY_TARGET_PORT=4000
Environment=GN_GATEWAY_TARGET_HOST=127.0.0.1
Environment=NODE_ENV=production

# ── Runtime ──
# Path absolut bun: systemd user service tidak mewarisi PATH shell (~/.npm-global/bin)
ExecStart=%h/.npm-global/bin/bun run %h/civil/goblin-vault/tools-cli/src/gn/src/index.ts gateway start --port 4010 --target-port 4000
WorkingDirectory=%h/civil/goblin-vault

# ── Resilience ──
Restart=always
RestartSec=3

# ── Security & Sandboxing ──
ProtectSystem=strict
PrivateTmp=true
NoNewPrivileges=true

# Allow write access to telemetry DB, prompt cache, and fixtures
ReadWritePaths=%h/.cache/gn
ReadWritePaths=%h/.cache/goblin-nexus
ReadWritePaths=%h/.config/gn

# Allow network loopback access (needed for proxy)
PrivateNetwork=no

# ── Logging ──
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
